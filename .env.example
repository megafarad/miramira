# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://miramira:miramira@localhost:5432/miramira

# OpenFGA
OPENFGA_API_URL=http://localhost:8080
# Populated after creating a store + authorization model (Phase 3+)
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=

# Supabase (for verifying user JWTs)
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# CORS origins allowed by the browser-facing API (comma-separated).
# Required in production; dev defaults to common localhost ports if unset.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# When set, `npm run db:seed` upserts this user and binds the admin role at the
# master tenant. Without it, every API endpoint 403s.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Hard ceiling on graceful shutdown after SIGTERM. Defaults to 30s to match
# k8s' default terminationGracePeriodSeconds.
# SHUTDOWN_TIMEOUT_MS=30000
